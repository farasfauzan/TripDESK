{
  "name": "tripdesk-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API untuk Tripdesk - pemesanan tiket travel shuttle antarkota",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "node --check src/index.js && node --check src/app.js && node --check src/store.js && node --check src/db.js",
    "migrate": "node scripts/migrate.mjs",
    "test:status": "node scripts/test-status.mjs",
    "test:api": "node scripts/test-api.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  }
}
